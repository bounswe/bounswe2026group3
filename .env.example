SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase / PostgreSQL connection (configured by Ali)
DB_HOST=your-supabase-host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Trust score deltas
TRUST_SCORE_VERIFIED_DELTA=5
TRUST_SCORE_MALICIOUS_DELTA=10
TRUSTED_REPUTATION_THRESHOLD=50

# Upvote-driven auto-verification thresholds (strict greater-than)
AUTO_VERIFY_UPVOTE_THRESHOLD=5
AUTO_VERIFY_TRUSTED_UPVOTE_THRESHOLD=3
